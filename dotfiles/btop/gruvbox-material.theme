# Gruvbox Material (medium-dark) — same palette as kitty, Waybar and Hyprland.
# bg #32302f  fg #d4be98  gray #928374
# red #ea6962  orn #e78a4e  ylw #d8a657  grn #a9b665  aqu #89b482  blu #7daea3  pur #d3869b

# Empty background lets kitty's own background (and opacity) show through.
theme[main_bg]=""
theme[main_fg]="#d4be98"
theme[title]="#d4be98"
theme[hi_fg]="#e78a4e"
theme[selected_bg]="#504945"
theme[selected_fg]="#d8a657"
theme[inactive_fg]="#665c54"
theme[graph_text]="#ddc7a1"
theme[meter_bg]="#3c3836"
theme[proc_misc]="#89b482"

theme[cpu_box]="#7daea3"
