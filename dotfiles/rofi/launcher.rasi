/* App launcher — Gruvbox, two columns.
 * Layout adapted from adi1090x/rofi (launchers/type-2, style-2, GPL-3.0). */

configuration {
    modi:                  "drun,filebrowser,window";
    show-icons:            true;
    icon-theme:            "Papirus-Dark";
    display-drun:          "";
    drun-display-format:   "{name}";
}

* {
    font:            "JetBrainsMono Nerd Font 13";
    background:      #282828FF;
    background-alt:  #353535FF;
    foreground:      #EBDBB2FF;
    selected:        #83A598FF;
    active:          #B8BB26FF;
    urgent:          #FB4934FF;
}

window {
    transparency:      "real";
    location:          center;
    anchor:            center;
    width:             600px;
    height:            400px;
    border-radius:     12px;
    background-color:  @background;
}

mainbox {
    spacing:           10px;
    padding:           20px;
    background-color:  transparent;
    children:          [ "inputbar", "listview" ];
}

inputbar {
    spacing:           10px;
    padding:           15px;
    border-radius:     12px;
    background-color:  @background-alt;
    text-color:        @foreground;
    children:          [ "prompt", "entry" ];
}

prompt, entry {
    background-color:  inherit;
    text-color:        inherit;
}

entry {
    cursor:             text;
    placeholder:        "Search...";
    placeholder-color:  inherit;
}

listview {
    columns:           2;
    lines:             8;
    cycle:             true;
    dynamic:           true;
    scrollbar:         false;
    fixed-height:      true;
    fixed-columns:     true;
    spacing:           5px;
    background-color:  transparent;
    text-color:        @foreground;
}

element {
    spacing:           10px;
    padding:           5px;
    border-radius:     12px;
    background-color:  transparent;
    text-color:        @foreground;
    cursor:            pointer;
}

element normal.normal {
    background-color:  @background;
    text-color:        @foreground;
}

element selected.normal {
    background-color:  @selected;
    text-color:        @background;
}

element-icon {
    background-color:  transparent;
    text-color:        inherit;
    size:              32px;
}

element-text {
    background-color:  transparent;
    text-color:        inherit;
    highlight:         inherit;
    vertical-align:    0.5;
}

error-message {
    padding:           15px;
    border:            2px solid;
    border-radius:     12px;
    border-color:      @selected;
    background-color:  @background;
    text-color:        @foreground;
}

textbox {
    background-color:  @background;
    text-color:        @foreground;
    vertical-align:    0.5;
}
